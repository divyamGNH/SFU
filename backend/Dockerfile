# Have a builder file do the heavy lifting and create the binary code.
FROM golang:1.23-alpine AS builder

WORKDIR /app

# Copy the dependencies and download them.
COPY go.mod go.sum ./
RUN go mod download

# Copy the remaining code.
COPY . .

# Simply build the binary of this file in the builder container.
# CGO_ENABLED=0 means prevent GO from using compiler/OS's C libraries.
# GOOS forces GO to spit out a linux binary as GO supports multiple systems so it might accidently give .exe for windows on a linux VM that would crash.
RUN CGO_ENABLED=0 GOOS=linux go build -o media-node .

# Final Image code only have the binary generated and nothing else.
# Prevents the image to be large in size and also is very safe as this has only the binary and no compiler, libraries etc.
FROM alpine:latest
WORKDIR /root/

# Copy the binary generated by the builder earlier.
COPY --from=builder /app/media-node .

# Our media code uses a TCP connection for the gRPC connection and multiple dynamic UDP ports for the media on the fly. So we can not hardcode the ports and expose them.
# we will use --network host when starting the container so that the docker container drops its internal fake network and uses the host machine's network.

CMD ["./media-node"]